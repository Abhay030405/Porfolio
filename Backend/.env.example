PORT=3000
# Comma-separated list of origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:8080,https://itsabhay.me,https://www.itsabhay.me,https://abhay.si,https://www.abhay.si

# Neon Postgres connection string (use the pooled one)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Admin login — don't edit by hand, run `npm run set-password`
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# AI drafts on the admin pages
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Jev picks the chat tool for typed questions (optional — without it, keyword matching decides)
TYPESAFE_API_KEY=your_typesafe_api_key
