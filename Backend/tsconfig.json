{
  // Type-checking only — Node runs the .ts files directly (type stripping),
  // so this mirrors what that allows: no enums, no namespaces, explicit .ts imports.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "scripts", "seed"]
}
