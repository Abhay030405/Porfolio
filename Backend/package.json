{
  "name": "gpt-portfolio-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Portfolio API: published content, admin editing with AI drafts, and chat routing",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "set-password": "node --env-file-if-exists=.env scripts/set-password.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@neondatabase/serverless": "^1.2.0",
    "hono": "^4.13.13",
    "mammoth": "^1.13.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
